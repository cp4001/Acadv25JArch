<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>JArchSbLicenseTest</AssemblyName>
    <RootNamespace>JArchSbLicenseTest</RootNamespace>
    <!-- JArchSbLicense.dll 이 x64 네이티브다. AnyCPU 로 두면 32비트로 실행될 때
         BadImageFormatException 이 난다. 명시적으로 못 박는다. -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- cpp/ 에서 빌드한 네이티브 DLL 을 출력 폴더로 복사한다.
         P/Invoke 는 exe 옆을 먼저 찾으므로 이것만으로 해결된다.
         cpp\build.bat 을 먼저 돌려야 이 파일이 존재한다. -->
    <None Include="..\..\cpp\JArchSbLicense.dll"
          Link="JArchSbLicense.dll"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
