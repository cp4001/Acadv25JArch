<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	 <UseWindowsForms>true</UseWindowsForms>
    <TargetFramework>net8.0-windows8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  <!-- 출력 경로 설정 - 하위 폴더 생성 방지 -->
	  <BaseOutputPath>C:\Jarch25\</BaseOutputPath>
	  <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	  <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <EnableNETAnalyzers>False</EnableNETAnalyzers>
    <Platforms>AnyCPU;x64</Platforms>

  </PropertyGroup>

  <!-- 출력 경로를 구성별로 분리.
       Debug   : C:\Jarch25\        (개발용 NETLOAD 경로 - 기존과 동일하게 유지)
       Release : C:\Jarch25\Release\ (배포용 - 인스톨러가 이 경로를 참조)
       한 폴더를 공유하면 경로만 봐서는 Debug/Release 구분이 안 되어
       Debug 산출물이 배포본에 섞이는 사고가 난다. -->
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <OutputPath>C:\Jarch25\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <OutputPath>C:\Jarch25\Release\</OutputPath>
  </PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.WindowsDesktop.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="EPPlus" Version="8.3.1" />
		<PackageReference Include="Microsoft.VisualStudio.Services.Client" Version="19.225.1" />
		<PackageReference Include="OpenStudio.win-x64" Version="3.10.0" />
		<PackageReference Include="System.Drawing.Common" Version="8.0.0" />
	</ItemGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <Optimize>False</Optimize>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <DebugType>full</DebugType>
    <NoWarn>0067;0414;1701;1702;8073;8600;8601;8602;8603;8604;8612;8618;8619;8620;8629;8767;MSB3277</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <Optimize>False</Optimize>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <DebugType>full</DebugType>
    <NoWarn>0067;0414;1701;1702;8073;8600;8601;8602;8603;8604;8612;8618;8619;8620;8629;8767;MSB3277</NoWarn>
  </PropertyGroup>

  <!-- Release 는 실제로 최적화된 산출물이어야 한다.
       (기존에는 Optimize=False + DebugType=full 이라 이름만 Release 인 Debug 빌드였다) -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <Optimize>True</Optimize>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <DebugType>portable</DebugType>
    <NoWarn>0067;0414;1701;1702;8073;8600;8601;8602;8603;8604;8612;8618;8619;8620;8629;8767;MSB3277</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <Optimize>True</Optimize>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <DebugType>portable</DebugType>
    <NoWarn>0067;0414;1701;1702;8073;8600;8601;8602;8603;8604;8612;8618;8619;8620;8629;8767;MSB3277</NoWarn>
  </PropertyGroup>


  <ItemGroup>
